#!/bin/sh
# Cheap hook entry for events that fire often (after every tool call). Exit at once unless a
# message from the user is queued or a turn is held on the user; otherwise behave exactly like layover.
data="${LAYOVER_DATA:-$HOME/Library/Application Support/Layover}/data"
xdg="${XDG_DATA_HOME:-$HOME/.local/share}/Layover/data"
[ -f "$data/outbox.flag" ] || [ -f "$data/holding.flag" ] || [ -f "$xdg/outbox.flag" ] || [ -f "$xdg/holding.flag" ] || exit 0
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
exec "$(dirname "$self")/layover" "$@"
